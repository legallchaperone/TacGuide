{
  "_comment": "Grasp Chip task queue (plan section 任务队列). Paths are relative to cwd. Lower priority number runs first. Training A and B is launched by whoever owns phase 3; flip `enabled` to hand them to the scheduler. chosen_w.txt holds the w picked in phase 4 (e.g. `2` or `1.5`). A first launch uses --overwrite because the trainer refuses an existing run directory; once a checkpoint exists the resume command is used instead. C and D save every 1000 steps and keep the two newest checkpoints plus the final one.",
  "cwd": "$HOME/TacGuide",
  "state_dir": "$TG/queue",
  "log_dir": "$TG/queue/logs",
  "jobs": [
    {
      "name": "train_gc_A",
      "enabled": false,
      "priority": 1,
      "requires": [
        "data/training/lerobot/gc",
        "data/training/stats/openvtla/gc/norm_stats.json",
        "weights/anytouch2/checkpoint-4frames.pth",
        "weights/pi05_base_pytorch/model.safetensors"
      ],
      "cmd": "training/tacguide.sh train gc_A {gpu} --overwrite",
      "resume_if": "outputs/training/openvtla/gc/gc_A/[0-9]*/model.safetensors",
      "resume_cmd": "training/tacguide.sh train gc_A {gpu} --resume",
      "done_if": "outputs/training/openvtla/gc/gc_A/10000/model.safetensors"
    },
    {
      "name": "train_gc_B",
      "enabled": false,
      "priority": 1,
      "requires": [
        "data/training/lerobot/gc",
        "data/training/stats/pi05/gc/norm_stats.json",
        "weights/pi05_base_pytorch/model.safetensors"
      ],
      "cmd": "training/tacguide.sh train gc_B {gpu} --overwrite",
      "resume_if": "outputs/training/pi05/gc/gc_B/[0-9]*/model.safetensors",
      "resume_cmd": "training/tacguide.sh train gc_B {gpu} --resume",
      "done_if": "outputs/training/pi05/gc/gc_B/10000/model.safetensors"
    },
    {
      "name": "train_gc_D",
      "priority": 3,
      "vars_from": {
        "w": "$TG/queue/chosen_w.txt"
      },
      "requires": [
        "outputs/training/openvtla/gc/gc_A/10000/model.safetensors",
        "outputs/training/pi05/gc/gc_B/10000/model.safetensors",
        "training/tacguide/train_distill.py"
      ],
      "cmd": "source training/tacguide_env.sh && $TG/venv/bin/python training/tacguide/train_distill.py gc_D_w{w} --overwrite --save-interval 1000",
      "resume_if": "outputs/training/pi05/gc/gc_D_w{w}/[0-9]*/model.safetensors",
      "resume_cmd": "source training/tacguide_env.sh && $TG/venv/bin/python training/tacguide/train_distill.py gc_D_w{w} --resume --save-interval 1000",
      "done_if": "outputs/training/pi05/gc/gc_D_w{w}/10000/model.safetensors"
    },
    {
      "name": "train_gc_C",
      "priority": 3.5,
      "requires": [
        "outputs/training/openvtla/gc/gc_A/10000/model.safetensors",
        "training/tacguide/train_distill.py"
      ],
      "cmd": "source training/tacguide_env.sh && $TG/venv/bin/python training/tacguide/train_distill.py gc_C --overwrite --save-interval 1000",
      "resume_if": "outputs/training/pi05/gc/gc_C/[0-9]*/model.safetensors",
      "resume_cmd": "source training/tacguide_env.sh && $TG/venv/bin/python training/tacguide/train_distill.py gc_C --resume --save-interval 1000",
      "done_if": "outputs/training/pi05/gc/gc_C/10000/model.safetensors"
    },
    {
      "name": "train_gc_D_w2_extra",
      "priority": 5,
      "requires": [
        "outputs/training/openvtla/gc/gc_A/10000/model.safetensors",
        "outputs/training/pi05/gc/gc_B/10000/model.safetensors",
        "training/tacguide/train_distill.py"
      ],
      "cmd": "source training/tacguide_env.sh && $TG/venv/bin/python training/tacguide/train_distill.py gc_D_w2 --overwrite --save-interval 1000",
      "resume_if": "outputs/training/pi05/gc/gc_D_w2/[0-9]*/model.safetensors",
      "resume_cmd": "source training/tacguide_env.sh && $TG/venv/bin/python training/tacguide/train_distill.py gc_D_w2 --resume --save-interval 1000",
      "done_if": "outputs/training/pi05/gc/gc_D_w2/10000/model.safetensors",
      "enabled": false
    }
  ]
}
